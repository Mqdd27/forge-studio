NEXT_PUBLIC_SITE_URL=https://forgestudio.dev
# HTTPS endpoint that accepts inquiry JSON and acknowledges delivery with a 2xx response.
# Configure the business-owned delivery destination before launch.
INQUIRY_WEBHOOK_URL=
# Email delivery via Resend (takes precedence over the webhook when set).
# With the default onboarding@resend.dev sender, Resend only delivers to the Resend account's own email;
# verify risencode.dev in Resend and set INQUIRY_EMAIL_FROM (e.g. RisenDev <hello@risencode.dev>) for anything else.
RESEND_API_KEY=
INQUIRY_EMAIL_TO=risendcode@gmail.com
INQUIRY_EMAIL_FROM=
INQUIRY_WEBHOOK_TOKEN=
# Set only if your trusted reverse proxy overwrites this client-IP header.
INQUIRY_TRUSTED_IP_HEADER=
